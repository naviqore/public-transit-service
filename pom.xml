<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.naviqore</groupId>
    <artifactId>naviqore</artifactId>
    <version>4.2.1</version>
    <packaging>pom</packaging>

    <name>Naviqore</name>
    <description>
        Parent POM for the public transit schedule information and connection routing service project.
    </description>
    <url>https://github.com/naviqore/public-transit-service</url>

    <modules>
        <module>app</module>
        <module>benchmark</module>
        <module>libs</module>
    </modules>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>munterfi</id>
            <name>Merlin Unterfinger</name>
            <url>https://github.com/munterfi</url>
        </developer>
        <developer>
            <id>brunner246</id>
            <name>Michael Brunner</name>
            <url>https://github.com/Brunner246</url>
        </developer>
        <developer>
            <id>clukas1</id>
            <name>Lukas Connolly</name>
            <url>https://github.com/clukas1</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/naviqore/public-transit-service.git</connection>
        <developerConnection>scm:git:ssh://github.com/naviqore/public-transit-service.git</developerConnection>
        <url>https://github.com/naviqore/public-transit-service</url>
    </scm>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.failOnWarning>true</maven.compiler.failOnWarning>
        <lombok.version>1.18.48</lombok.version>
        <errorprone.version>2.53.0</errorprone.version>
        <nullaway.version>0.14.4</nullaway.version>
        <!--
            StringConcatToTextBlock crashes on code generated by Lombok, SameNameButDifferent and EqualsGetClass are
            matters of style, StringSplitter recommends Guava, which is not used, and records hold arrays on purpose
            (see AGENTS.md).
        -->
        <errorprone.args>
            -XepDisableWarningsInGeneratedCode
            -Xep:StringConcatToTextBlock:OFF
            -Xep:SameNameButDifferent:OFF
            -Xep:EqualsGetClass:OFF
            -Xep:StringSplitter:OFF
            -Xep:ArrayRecordComponent:OFF
            -Xep:NullAway:ERROR
            -XepOpt:NullAway:OnlyNullMarked=true
            -XepOpt:NullAway:JSpecifyMode=true
            -XepOpt:NullAway:AssertsEnabled=true
        </errorprone.args>
        <!-- empty default, set by JaCoCo -->
        <argLine/>
        <sonar.organization>naviqore</sonar.organization>
        <sonar.projectKey>naviqore_public-transit-service</sonar.projectKey>
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>
        <!-- records hold arrays on purpose and are never compared, see AGENTS.md -->
        <sonar.issue.ignore.multicriteria>rec</sonar.issue.ignore.multicriteria>
        <sonar.issue.ignore.multicriteria.rec.ruleKey>java:S6218</sonar.issue.ignore.multicriteria.rec.ruleKey>
        <sonar.issue.ignore.multicriteria.rec.resourceKey>**/*.java</sonar.issue.ignore.multicriteria.rec.resourceKey>
    </properties>

    <dependencies>
        <!-- testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>6.1.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.24.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>5.24.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.27.7</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
            <version>1.0.1</version>
            <scope>compile</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <!-- analysis for SonarQube Cloud, run by the Maven CI workflow -->
                <plugin>
                    <groupId>org.sonarsource.scanner.maven</groupId>
                    <artifactId>sonar-maven-plugin</artifactId>
                    <version>5.9.0.7382</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- compile with all lint checks, Error Prone and NullAway, and fail on any warning -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
                <configuration>
                    <showWarnings>true</showWarnings>
                    <showDeprecation>true</showDeprecation>
                    <compilerArgs>
                        <arg>-Xlint:all,-processing,-classfile,-serial</arg>
                        <arg>-XDcompilePolicy=simple</arg>
                        <arg>--should-stop=ifError=FLOW</arg>
                    </compilerArgs>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>com.google.errorprone</groupId>
                            <artifactId>error_prone_core</artifactId>
                            <version>${errorprone.version}</version>
                        </path>
                        <path>
                            <groupId>com.uber.nullaway</groupId>
                            <artifactId>nullaway</artifactId>
                            <version>${nullaway.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <configuration>
                            <compilerArgs combine.children="append">
                                <arg>-Xplugin:ErrorProne ${errorprone.args}</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                    <!-- tests may pass null to check how the code handles it -->
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <compilerArgs combine.children="append">
                                <arg>-Xplugin:ErrorProne ${errorprone.args} -Xep:NullAway:OFF
                                    -Xep:JavaTimeDefaultTimeZone:OFF
                                </arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- integration tests -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.1</version>
                <configuration>
                    <argLine>@{argLine} -XX:+EnableDynamicAgentLoading -Xshare:off</argLine>
                    <excludes>
                        <exclude>**/*IT.java</exclude>
                        <exclude>**/*IT$*.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <argLine>@{argLine} -XX:+EnableDynamicAgentLoading -Xshare:off</argLine>
                    <includes>
                        <include>**/*IT.java</include>
                        <include>**/*IT$*.java</include>
                    </includes>
                </configuration>
            </plugin>
            <!-- test coverage for SonarQube Cloud -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.16</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- sign and publish to maven central -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
                <version>3.2.8</version>
                <executions>
                    <execution>
                        <phase>deploy</phase>
                        <goals>
                            <goal>sign</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <version>0.12.0</version>
                <extensions>true</extensions>
                <configuration>
                    <deploymentName>${project.artifactId}:${project.version}</deploymentName>
                    <autoPublish>true</autoPublish>
                    <waitUntil>validated</waitUntil>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
